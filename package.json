{
  "name": "printing-business-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"npm run dev:api\"",
    "dev:api": "nodemon backend/server.js",
    "build": "node scripts/verify-media.mjs && node scripts/verify-banner-pricing.mjs && node scripts/verify-prerender-meta.mjs && vite build && node scripts/prerender.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "audit:locations": "node scripts/audit-locations.mjs",
    "test:seo": "node scripts/test-seo-invariants.mjs",
    "test:products": "node scripts/test-product-consistency.mjs",
    "test": "npm run build && node scripts/verify-tension-podium-pricing.mjs && npm run audit:seo && npm run audit:locations && npm run test:seo && npm run test:products",
    "preview": "vite preview",
    "start": "node backend/server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "axios": "^1.7.0",
    "cors": "^2.8.1",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.1",
    "fabric": "^5.3.0",
    "markdown-it": "^14.3.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.21.0",
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.0.1",
    "nodemon": "^3.1.0",
    "vite": "^5.4.10"
  }
}
