# =============================================================================
# Directus — Apex Trade Show CMS
# =============================================================================
# Copy to `directus/.env` and fill in. `directus/.env` is gitignored; never
# commit real values. None of the variables here replace or modify the existing
# Stripe or Supabase credentials used by the storefront — Directus gets its own.
#
#   cp directus/.env.example directus/.env
#   cd directus && npm install && npm run bootstrap && npm start
# =============================================================================

# --- Database: Supabase Postgres ---------------------------------------------
# Supabase Dashboard -> Project Settings -> Database -> Connection string ->
# "Session pooler". Copy the host and user from there verbatim.
#
# Use the SESSION POOLER (port 5432), NOT the transaction pooler (6543).
# Directus runs migrations and multi-statement transactions and needs prepared
# statements, which the transaction pooler does not support.
#
# Do NOT use the direct connection (db.<ref>.supabase.co). It is IPv6-only on
# current projects and does not resolve from most Docker networks.
#
# Two things that are easy to get wrong:
#   - The host carries an instance number that is NOT always aws-0. Ours is
#     aws-1-us-east-2. Guessing it wrong gives:
#     "tenant/user postgres.<ref> not found".
#   - DB_USER must be postgres.<project-ref>, not plain postgres. Without the
#     suffix the pooler answers "no tenant identifier provided".
#
# Save this file with LF line endings. Docker's env_file parser carries a
# trailing CR into the value on CRLF files, which fails authentication with a
# password that looks correct.
#
# DB_SEARCH_PATH puts every Directus table in its own `directus` schema, so the
# ~30 directus_* tables can never collide with the storefront's tables (orders,
# blog_posts, pricing_overrides, …) and are unaffected by their RLS policies.
DB_CLIENT=pg
DB_HOST=aws-<n>-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USER=postgres.<your-project-ref>
DB_PASSWORD=your-supabase-db-password
DB_SSL__REJECT_UNAUTHORIZED=false
DB_SEARCH_PATH=directus,public

# --- Security ----------------------------------------------------------------
# Generate each with: openssl rand -hex 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# KEY identifies this instance; SECRET signs access tokens. Changing SECRET logs
# everyone out. Never reuse the storefront's Supabase service-role key here.
KEY=replace-with-32-byte-random-hex
SECRET=replace-with-32-byte-random-hex

# --- First admin user (used once, by `npm run bootstrap`) ---------------------
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=change-me-immediately-after-first-login

# --- Public URL --------------------------------------------------------------
# The externally reachable URL of this Directus instance. Must be exact — it is
# used for asset URLs, OAuth redirects and the admin app's own API calls.
PUBLIC_URL=http://localhost:8055
HOST=0.0.0.0
PORT=8055

# --- CORS --------------------------------------------------------------------
# Origins allowed to call the Directus API from a browser. Add the production
# storefront and any preview domains. Build-time sync runs server-side and does
# not need CORS.
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:5173,https://www.apextradeshow.com

# --- File storage ------------------------------------------------------------
# `local` writes to directus/uploads (gitignored) — fine for a single host.
# For multi-instance or serverless hosting, switch to S3-compatible storage
# (Supabase Storage is S3-compatible) by setting the s3 block below instead.
STORAGE_LOCATIONS=local
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads

# Optional S3 / Supabase Storage backend — uncomment to use instead of local.
# STORAGE_LOCATIONS=s3
# STORAGE_S3_DRIVER=s3
# STORAGE_S3_KEY=
# STORAGE_S3_SECRET=
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ENDPOINT=https://xxxxxxxxxxxxxxxx.supabase.co/storage/v1/s3
# STORAGE_S3_FORCE_PATH_STYLE=true

# --- Uploads -----------------------------------------------------------------
FILES_MAX_UPLOAD_SIZE=25mb

# --- Rate limiting -----------------------------------------------------------
RATE_LIMITER_ENABLED=true
RATE_LIMITER_POINTS=50
RATE_LIMITER_DURATION=1

# --- Telemetry ---------------------------------------------------------------
TELEMETRY=false

# --- Read-only token for the build-time sync ---------------------------------
# Created after first login (Settings -> Access Tokens) for a user restricted to
# read-only access. The storefront build uses it to pull published content; it
# must never be an admin token. Store the same value in the STOREFRONT env as
# DIRECTUS_TOKEN (see the root .env.example).
# DIRECTUS_STATIC_TOKEN=
