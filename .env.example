# ============================================================================
# Copy this file to `.env` for local dev. In Vercel, set the same keys under
# Project → Settings → Environment Variables. Never commit real keys.
# ============================================================================

# ---- Frontend (browser-safe, must start with VITE_) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Comma-separated emails that see the Admin link (UI only).
VITE_ADMIN_EMAILS=you@example.com

# ---- Server / API (keep secret) ----
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SECRET — server only
SUPABASE_ANON_KEY=your-anon-public-key
STRIPE_SECRET_KEY=sk_test_xxx                      # enables Stripe payments
STRIPE_WEBHOOK_SECRET=whsec_xxx                    # reliable paid status (Stripe → Webhooks)
ADMIN_EMAILS=you@example.com                       # staff emails (enforced by API)
# PUBLIC_BASE_URL=https://your-app.vercel.app       # optional: Stripe redirect base

# ---- Email notifications (Resend — resend.com) ----
RESEND_API_KEY=re_xxx                              # enables order emails
EMAIL_FROM=PrintUSA <orders@yourdomain.com>        # must be a Resend-verified domain
# BRAND_NAME=PrintUSA                               # optional: name used in emails

# --- Brevo (marketing email list) ---------------------------------------------
# Brevo is the list host and data controller for marketing contacts; no local
# copy of subscriber addresses is kept. Both must be set for /api/subscribe to
# do anything — unset, it accepts the address and reports status "skipped".
BREVO_API_KEY=xkeysib-xxx                          # Brevo -> SMTP & API -> API keys (v3)
BREVO_LIST_ID=2                                    # numeric id of the target list

# --- Directus CMS (storefront side) -------------------------------------------
# The build pulls published content from Directus and writes snapshots into
# src/data/*.generated.js. Both are optional: with them unset the build uses the
# committed snapshots, so a CMS outage never breaks a deploy.
# Directus's OWN configuration lives in directus/.env — see directus/README.md.
DIRECTUS_URL=http://localhost:8055                 # public URL of the Directus instance
DIRECTUS_TOKEN=                                    # READ-ONLY static token, never an admin token

# --- Address lookup (optional) -----------------------------------------------
# The order and quote forms suggest addresses as the customer types. With no key
# this uses Photon (OpenStreetMap data), which needs no account and no billing.
#
# Set this to use Google Places instead — better coverage of new-build and rural
# addresses, billed per request. RESTRICT THE KEY BY HTTP REFERRER in the Google
# console: it is used from the browser, so an unrestricted key can be spent by
# anyone who finds it.
# VITE_GOOGLE_PLACES_KEY=
