# =============================================================================
# Apex Trade Show — storefront environment
#
# Copy to `.env.local` for local development. In Vercel set the same keys under
# Project -> Settings -> Environment Variables.
#
# THIS FILE IS COMMITTED. It must only ever contain placeholders. If you paste a
# real key here it is in git history for good, and rotating it is the only fix.
#
# Directus's OWN configuration is a separate file — see directus/.env.example.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Frontend. Anything prefixed VITE_ is compiled INTO the JavaScript bundle
#    and is readable by anyone who opens the site. Never put a secret here.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Comma-separated emails that see the Admin link. Cosmetic only — the API
# enforces access separately via ADMIN_EMAILS below.
VITE_ADMIN_EMAILS=you@example.com

# -----------------------------------------------------------------------------
# 2. Supabase (server side). The service role key bypasses every Row Level
#    Security policy. It belongs on the server only, never in a VITE_ var.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Staff emails, enforced by the API on every admin route.
ADMIN_EMAILS=you@example.com

# -----------------------------------------------------------------------------
# 3. Payments. Use TEST keys everywhere except production.
#    Without STRIPE_WEBHOOK_SECRET an order can never be confirmed as paid,
#    because the webhook signature cannot be verified.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Base URL Stripe returns the customer to after checkout.
PUBLIC_BASE_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# 4. Transactional email. Either Resend OR SMTP — the mailer prefers Resend and
#    falls back to SMTP. With neither set, email is skipped and logged.
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxx
EMAIL_FROM=Apex Trade Show <orders@yourdomain.com>
# SMTP fallback
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# Who receives a copy of every quote request (comma separated).
QUOTE_NOTIFY_EMAILS=sales@yourdomain.com

# -----------------------------------------------------------------------------
# 5. Brand details used in emails and page footers. All optional — each falls
#    back to the value in src/config/brand.js.
# -----------------------------------------------------------------------------
# BRAND_NAME=Apex Trade Show
# CONTACT_EMAIL=hello@yourdomain.com
# CONTACT_PHONE=(555) 123-4567
# CONTACT_PHONE_HREF=+15551234567
# CONTACT_HOURS=Mon-Fri 9am-6pm EST

# -----------------------------------------------------------------------------
# 6. Marketing list (Brevo). Both must be set or /api/subscribe accepts the
#    address and reports status "skipped".
# -----------------------------------------------------------------------------
BREVO_API_KEY=xkeysib-xxx
BREVO_LIST_ID=2

# -----------------------------------------------------------------------------
# 7. Directus CMS, read by the storefront build.
#    Both optional: unset, the build uses the committed snapshots in
#    src/data/*.generated.js, so a CMS outage never breaks a deploy.
# -----------------------------------------------------------------------------
DIRECTUS_URL=http://localhost:8055
# READ-ONLY static token. Never an admin token — this is used at build time and
# only ever needs to read published content.
DIRECTUS_TOKEN=

# Admin credentials, used ONLY by scripts/migrate-directus/*. Not needed to run
# or build the site. Leave blank unless you are running a content migration.
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=
# DIRECTUS_ADMIN_TOKEN=            # alternative to email+password
# Origin the image migration fetches product photos from.
# MIGRATE_IMAGE_ORIGIN=https://www.apextradeshow.com

# -----------------------------------------------------------------------------
# 8. Content API + rebuilds. CONTENT_API_KEY protects the endpoint that lets the
#    dashboard write content; a deploy hook triggers a rebuild after a change.
# -----------------------------------------------------------------------------
CONTENT_API_KEY=generate-a-long-random-string
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/xxx

# -----------------------------------------------------------------------------
# 9. Currency conversion. Optional — defaults are in backend/lib/fx.js.
# -----------------------------------------------------------------------------
# FX_RATES_URL=https://open.er-api.com/v6/latest/USD
# FX_TTL_MS=43200000

# -----------------------------------------------------------------------------
# 10. Address lookup (optional).
#     With no key the forms use Photon (OpenStreetMap) — no account, no billing.
#     A Google Places key gives better new-build and rural coverage, billed per
#     request. RESTRICT IT BY HTTP REFERRER in the Google console: it ships in
#     the browser bundle, so an unrestricted key can be spent by anyone.
# -----------------------------------------------------------------------------
# VITE_GOOGLE_PLACES_KEY=

# -----------------------------------------------------------------------------
# 11. Test-only. Not needed for development.
# -----------------------------------------------------------------------------
# ACCEPTANCE_ORIGIN=http://localhost:4173   # target for scripts/acceptance.mjs
